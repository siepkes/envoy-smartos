 )
 
+# illumos / SmartOS: LuaJIT treats it as Solaris (LJ_TARGET_SOLARIS in lj_arch.h), which is an
+# ELF x64 target like Linux as far as buildvm is concerned.
+config_setting(
+    name = "illumos_x86_64",
+    constraint_values = [
+        "@platforms//cpu:x86_64",
+        "@platforms//os:illumos",
+    ],
+)
+
