     if arch == "riscv64":
         arch = "riscv64gc"
 
+    os_name = repository_ctx.os.name.lower()
+
+    # illumos (and SmartOS) report `repository_ctx.os.name` as "sunos". Solaris
+    # is accepted as well since both share the `*-unknown-illumos` Rust target.
+    if "illumos" in os_name or "sunos" in os_name or "solaris" in os_name:
+        _validate_cpu_architecture(arch, supported_architectures["illumos"])
+        return triple("{}-unknown-illumos".format(arch))
+
     if "linux" in repository_ctx.os.name:
         _validate_cpu_architecture(arch, supported_architectures["linux"])
         prefix = "{}-unknown-linux".format(arch)
