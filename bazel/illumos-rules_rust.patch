-    elif len(CARGO_BAZEL_URLS) == 0:
+    elif len(CARGO_BAZEL_URLS) == 0 or host_triple.str not in CARGO_BAZEL_URLS:
+        # No prebuilt `cargo-bazel` exists for this host (eg. x86_64-unknown-illumos), so build it
