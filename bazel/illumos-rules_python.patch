diff --git a/python/private/toolchains_repo.bzl b/python/private/toolchains_repo.bzl
--- a/python/private/toolchains_repo.bzl
+++ b/python/private/toolchains_repo.bzl
@@ -456,6 +456,40 @@ Major.Minor.Micro format. Keyed by index in `platforms`.
     },
 )
 
+def _system_python_host_repo_impl(rctx):
+    rctx.file("BUILD.bazel", _HOST_TOOLCHAIN_BUILD_CONTENT)
+    python = None
+    for name in ["python3", "python"]:
+        python = rctx.which(name)
+        if python:
+            break
+    if not python:
+        fail((
+            "No hermetic Python runtime is available for this host and no `python3` (or " +
+            "`python`) was found on PATH to use instead for the `{}` repository."
+        ).format(rctx.attr.base_name))
+    rctx.symlink(python, "python")
+
+system_python_host_repo = repository_rule(
+    implementation = _system_python_host_repo_impl,
+    doc = """\
+Stand-in for `host_compatible_python_repo` on hosts for which no hermetic runtime exists (for
+example illumos / SmartOS): exposes the interpreter found on PATH as `python`, so that the
+`python_<version>_host` repositories that bzlmod users import with `use_repo()` still exist.
+""",
+    attrs = {
+        "base_name": attr.string(
+            doc = "The name arg, but without bzlmod canonicalization applied.",
+        ),
+        "python_version": attr.string(
+            doc = "The Python version the hermetic runtime would have had, for diagnostics.",
+        ),
+        "_rule_name": attr.string(default = "system_python_host_repo"),
+        "_rules_python_workspace": attr.label(default = Label("//:WORKSPACE")),
+    },
+    environ = ["PATH"],
+)
+
 def _multi_toolchain_aliases_impl(rctx):
     rules_python = rctx.attr._rules_python_workspace.repo_name
 
