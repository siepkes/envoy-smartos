--- a/lib/private/jq_toolchain.bzl
+++ b/lib/private/jq_toolchain.bzl
@@ -209,6 +209,15 @@ exports_files(["jq{ext}"])
         ext = ext,
     ))
 
+    # On illumos there is no prebuilt jq binary; use the one installed on the host
+    # (e.g. via pkgsrc). This requires `jq` to be available on PATH.
+    if repo_utils.is_illumos(rctx):
+        host_jq = rctx.which("jq")
+        if host_jq == None:
+            fail("jq was not found on PATH. On illumos/SmartOS install jq so the build can use the host binary.")
+        rctx.symlink(host_jq, "jq")
+        return
+
     rctx.symlink("../{name}_{platform}/jq{ext}".format(
         name = rctx.attr.name,
         platform = repo_utils.platform(rctx),
diff --git a/lib/private/repo_utils.bzl b/lib/private/repo_utils.bzl
index e700c3e..e7875fc 100644
--- a/lib/private/repo_utils.bzl
+++ b/lib/private/repo_utils.bzl
@@ -16,6 +16,11 @@ def _is_windows(rctx):
     """Returns true if the host operating system is Windows"""
     return rctx.os.name.lower().find("windows") != -1
 
+def _is_illumos(rctx):
+    """Returns true if the host operating system is illumos / Solaris (SunOS)"""
+    name = rctx.os.name.lower()
+    return name.startswith("sunos") or name.startswith("illumos") or name.startswith("solaris")
+
 def _os(rctx):
